<!DOCTYPE html>
<html>

<head>

    <title><%= lab %> | Node.js Lab</title>

    <meta name="viewport" content="width=device-width, initial-scale=1">

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <style>

        body {
            background: #f5eee7;
            color: #3b2920;
        }

        .top-header {
            background: #4b2e22;
            color: white;
            padding: 35px;
            border-radius: 0 0 25px 25px;
            margin-bottom: 35px;
        }

        .section-card {
            background: white;
            border: none;
            border-radius: 18px;
            box-shadow: 0 5px 18px rgba(75, 46, 34, 0.12);
            margin-bottom: 25px;
            overflow: hidden;
        }

        .section-title {
            background: #ead9ca;
            color: #4b2e22;
            padding: 15px 20px;
            font-weight: 600;
            font-size: 18px;
        }

        .section-body {
            padding: 22px;
        }

        .code-box {
            background: #211814;
            color: #f5eee7;
            padding: 20px;
            border-radius: 12px;
            overflow-x: auto;
            white-space: pre-wrap;
            font-size: 14px;
        }

        .output-box {
            background: #171717;
            color: #f1f1f1;
            padding: 20px;
            border-radius: 12px;
            min-height: 150px;
            white-space: pre-wrap;
        }

        .screenshot {
            max-width: 100%;
            border-radius: 12px;
            border: 1px solid #ddd;
            margin-top: 10px;
        }

        .file-card {
            border: 1px solid #ead9ca;
            border-radius: 14px;
            padding: 18px;
            margin-bottom: 18px;
        }

        .github-btn {
            background: #4b2e22;
            color: white;
        }

        .github-btn:hover {
            background: #352018;
            color: white;
        }

        .run-btn {
            background: #6b4635;
            color: white;
        }

        .run-btn:hover {
            background: #4b2e22;
            color: white;
        }

    </style>

</head>


<body>


<div class="top-header">

    <div class="container">

        <div class="d-flex justify-content-between align-items-center">

            <div>

                <h1 class="mb-2">
                    <%= lab %>
                </h1>

                <p class="mb-0">
                    Node.js Laboratory Work
                </p>

            </div>

            <a
                href="/"
                class="btn btn-light"
            >
                ← All Labs
            </a>

        </div>

    </div>

</div>


<div class="container pb-5">


    <!-- TASK / QUESTION -->

    <div class="section-card">

        <div class="section-title">
            📌 Task / Question
        </div>

        <div class="section-body">

            <% if (readme) { %>

                <pre style="white-space: pre-wrap;"><%= readme %></pre>

            <% } else { %>

                <p class="text-muted mb-0">
                    Task details are not available in README.md for this lab.
                </p>

            <% } %>

        </div>

    </div>


    <!-- SOLUTION -->

    <div class="section-card">

        <div class="section-title">
            💡 Solution / Explanation
        </div>

        <div class="section-body">

            <p>
                This section contains the solution implemented for
                <strong><%= lab %></strong>.
            </p>

            <p class="mb-0">
                The JavaScript files below contain the actual implementation.
                You can run the available programs and check their output.
            </p>

        </div>

    </div>


    <!-- CODE -->

    <div class="section-card">

        <div class="section-title">
            💻 Code
        </div>

        <div class="section-body">


            <% if (codeFiles && codeFiles.length > 0) { %>

                <% codeFiles.forEach(item => { %>

                    <div class="file-card">

                        <h5>
                            <%= item.name %>
                        </h5>

                        <pre class="code-box"><%= item.code %></pre>

                        <div class="mt-3">

                            <button
                                class="btn run-btn"
                                onclick="runFile('<%= item.name %>')"
                            >
                                ▶ Run
                            </button>

                            <a
                                href="/file/<%= encodeURIComponent(lab) %>/<%= encodeURIComponent(item.name) %>"
                                target="_blank"
                                class="btn btn-dark"
                            >
                                View Separately
                            </a>

                        </div>


                        <div class="mt-3">

                            <div class="small text-muted mb-2">
                                Live Output
                            </div>

                            <pre
                                id="output-<%= item.name.replace(/[^a-zA-Z0-9]/g, '-') %>"
                                class="output-box"
                            >Click Run to execute this program...</pre>

                        </div>

                    </div>

                <% }) %>


            <% } else { %>

                <p class="text-muted">
                    No JavaScript files found in this lab.
                </p>

            <% } %>

        </div>

    </div>


    <!-- SCREENSHOTS -->

    <div class="section-card">

        <div class="section-title">
            🖼 Output Screenshots
        </div>

        <div class="section-body">

            <% if (screenshots && screenshots.length > 0) { %>

                <div class="row g-4">

                    <% screenshots.forEach(image => { %>

                        <div class="col-md-6">

                            <div>

                                <p class="fw-semibold mb-2">
                                    <%= image %>
                                </p>

                                <img
                                    src="/screenshots/<%= encodeURIComponent(lab) %>/<%= encodeURIComponent(image) %>"
                                    class="screenshot"
                                    alt="<%= image %>"
                                >

                            </div>

                        </div>

                    <% }) %>

                </div>

            <% } else { %>

                <p class="text-muted mb-0">
                    No output screenshots available for this lab.
                </p>

            <% } %>

        </div>

    </div>


    <!-- GITHUB -->

    <div class="section-card">

        <div class="section-title">
            🔗 GitHub
        </div>

        <div class="section-body">

            <p>
                Source code and laboratory files are available in the GitHub
                repository.
            </p>

            <a
                href="<%= githubUrl %>"
                target="_blank"
                class="btn github-btn"
            >
                Open <%= lab %> on GitHub
            </a>

        </div>

    </div>


</div>


<script>

async function runFile(filename) {

    const safeName =
        filename.replace(/[^a-zA-Z0-9]/g, "-");

    const output =
        document.getElementById("output-" + safeName);

    if (!output) {
        return;
    }

    output.textContent =
        "Running " + filename + "...\n";


    try {

        const response = await fetch("/run", {

            method: "POST",

            headers: {
                "Content-Type": "application/json"
            },

            body: JSON.stringify({

                lab: "<%= lab %>",
                filename: filename

            })

        });


        const result =
            await response.json();


        output.textContent =
            result.output;


    } catch (error) {

        output.textContent =
            "Error while running program:\n" +
            error.message;

    }

}

</script>


</body>

</html>