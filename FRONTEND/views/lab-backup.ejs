<!DOCTYPE html>
<html>

<head>

    <title><%= lab %></title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

</head>

<body class="bg-light">

<div class="container py-5">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1><%= lab %></h1>

            <p class="text-muted">
                Select a JavaScript file to run
            </p>
        </div>

        <a
            href="/"
            class="btn btn-secondary"
        >
            ← All Labs
        </a>

    </div>


    <div class="row g-3">

        <% files.forEach(file => { %>

            <div class="col-md-6">

                <div class="card shadow-sm">

                    <div class="card-body">

                        <h5>
                            <%= file %>
                        </h5>

                        <div class="mt-3">

                            <button
                                class="btn btn-success"
                                onclick="runFile('<%= file %>')"
                            >
                                ▶ Run
                            </button>

                            <a
                                href="/file/<%= encodeURIComponent(lab) %>/<%= encodeURIComponent(file) %>"
                                class="btn btn-dark"
                                target="_blank"
                            >
                                View Code
                            </a>

                        </div>

                    </div>

                </div>

            </div>

        <% }) %>

    </div>


    <div class="card shadow-sm mt-5">

        <div class="card-header">
            <strong>Terminal Output</strong>
        </div>

        <div class="card-body">

            <pre
                id="output"
                class="bg-dark text-light p-4 rounded"
                style="min-height: 200px;"
            >Click Run to execute the program...</pre>

        </div>

    </div>

</div>


<script>

async function runFile(filename) {

    const output = document.getElementById("output");

    output.textContent =
        "Running " + filename + "...\n";

    try {

        const response = await fetch("/run", {

            method: "POST",

            headers: {
                "Content-Type": "application/json"
            },

            body: JSON.stringify({

                lab: "<%= lab %>",
                filename: filename

            })

        });

        const result = await response.json();

        output.textContent = result.output;

    } catch (error) {

        output.textContent =
            "Error while running program:\n" +
            error.message;

    }

}

</script>

</body>

</html>