<!DOCTYPE html>
<html>
<head>

    <title>NodeJS Practical Lab</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

</head>

<body class="bg-light">

<div class="container py-5">

    <div class="text-center mb-5">

        <h1 class="fw-bold">
            Node.js Practical Lab
        </h1>

        <p class="text-muted">
            LAB 1 to LAB 7
        </p>

    </div>

    <div class="row g-4">

        <% labs.forEach((lab, index) => { %>

            <div class="col-md-4">

                <div class="card shadow-sm h-100">

                    <div class="card-body text-center">

                        <h3>
                            LAB <%= index + 1 %>
                        </h3>

                        <p class="text-muted">
                            Node.js Practical
                        </p>

                        <a
                            href="/lab/<%= encodeURIComponent(lab) %>"
                            class="btn btn-primary"
                        >
                            Open Lab
                        </a>

                    </div>

                </div>

            </div>

        <% }) %>

    </div>

</div>

</body>
</html>